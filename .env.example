# ============================================================
# Relay environment variables template
# Usage: cp .env.example .env, then fill in the real values.
# .env is in .gitignore and is never committed.
# ============================================================

# ---------- Database (required, no defaults) ----------
# PostgreSQL connection for the relay database.
# The database itself must already exist (created separately on the
# PostgreSQL server, independent from WebTracker's database).
# Use a dedicated database account, not WebTracker's.
DB_HOST=your_db_host
DB_ACCOUNT=your_db_user
DB_PASSWORD=<redacted>

# ---------- Database name (optional, default relay) ----------
DB_NAME=relay

# ---------- Ports (optional) ----------
BACKEND_PORT=8890
FRONTEND_PORT=8090

# ---------- Public base URL (optional) ----------
# The canonical public address of this Relay deployment — the origin
# an external agent connects to (the app and the API live under the
# same origin, /api/...). The project prompt bundle prints this
# address. When it is not set, the bundle uses the origin the request
# came in on, falling back to http://localhost:<FRONTEND_PORT>.
# Example for the deployed server: PUBLIC_URL=http://129.146.97.44:3000
# PUBLIC_URL=

# ---------- Timezone (optional, default America/Phoenix) ----------
TZ=America/Phoenix
