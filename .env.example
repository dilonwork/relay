# ============================================================
# Relay environment variables template
# Usage: cp .env.example .env, then fill in the real values.
# .env is in .gitignore and is never committed.
# ============================================================

# ---------- Database (required, no defaults) ----------
# PostgreSQL connection for the relay database.
# The database itself must already exist (created separately on the
# PostgreSQL server, independent from WebTracker's database).
# Use a dedicated database account, not WebTracker's.
DB_HOST=your_db_host
DB_ACCOUNT=your_db_user
DB_PASSWORD=<redacted>

# ---------- Database name (optional, default relay) ----------
DB_NAME=relay

# ---------- Ports (optional) ----------
BACKEND_PORT=8890
FRONTEND_PORT=8090

# ---------- Timezone (optional, default America/Phoenix) ----------
TZ=America/Phoenix
